<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- AniSync talks to remote ANI-RSS instances over HTTP(S) and, in node
         mode, to an AniSync serve daemon on another machine. Both transports
         go through this permission; without it the app installs fine and then
         every request fails at runtime. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- usesCleartextTraffic: self-hosted ANI-RSS instances are almost always
         plain http on a LAN address (http://192.168.1.5:7777). From targetSdk
         28 on, this attribute defaults to false.

         Evidence check (see docs/build.md "明文 HTTP 实例的平台策略"):
         dart:io and Go's net/http both build their own sockets, and neither the
         Dart-side dart:io sources nor the native libflutter.so / Java engine
         classes contain any reference to NetworkSecurityPolicy /
         isCleartextTrafficPermitted / usesCleartextTraffic. So this is believed
         to be DEFENSIVE rather than a proven necessity, but the asymmetry is
         brutal: if it is needed and absent, every LAN instance silently reads
         as "cannot connect", with no hint that cleartext was the cause.

         Why the global switch instead of a network_security_config.xml:
         Android's network security config matches hostnames only, and has no
         CIDR/range syntax. Our target is "whatever address the user typed", so
         there is no hostname list that could express it. The global flag is the
         only form that actually covers the product's use case. -->
    <application
        android:label="AniSync"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
